  (text "USB to UART bridge design blocks" (exclude_from_sim no) (at 25.4 30.48 0) (effects (font (size 2.0 2.0) (thickness 0.254) (bold yes)) (justify left bottom)) (uuid "7292fe12-5995-403a-ac4e-902f6221f482"))
  (text "Interface: VBUS / USB_DP / USB_DM on the left (USBLC6-2SC6 ESD inside each block); UART on the right.\nActive-low handshake nets end in _N. Blocks with an internal 3.3V regulator expose no rail; CH340C/G take +3V3 as a pin; MCP2221A uses the global +3V3.\nNot included: CP2105 (no KiCad library symbol). EOL parts excluded: FT232RL, CP2102N-A01, CP2108-B02, CP2101, MCP2221." (exclude_from_sim no) (at 25.4 228.6 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "db2df134-88bb-4aaf-98a0-a22071d2bf90"))
