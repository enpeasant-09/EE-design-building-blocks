	(text "CP2102N-A02 USB-UART bridge (bus-powered)\\nVREGIN = VBUS (5V); internal LDO -> VDD = +3V3 out (I/O at 3.3V)\\nVBUS sense divider R1/R2 per datasheet; RST pull-up 1k\\nUART: TX/RX + RTS/CTS/DTR; unused GPIO left NC\\nAdd ESD (e.g. USBLC6-2) at the connector"
		(exclude_from_sim no)
		(at 30 30 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7180f984-17a3-4c46-817c-348e2cc35c99")
	)
